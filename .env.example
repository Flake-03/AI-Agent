# Copy thành .env, điền khóa thật và giữ file này ngoài Git.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini
POSTGRES_PASSWORD=replace_with_alphanumeric_password

# Chạy trực tiếp trên máy; Compose sẽ ghi đè hai giá trị này.
MCP_URL=http://127.0.0.1:8000/mcp
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
# DATABASE_URL=postgresql://agent:password@127.0.0.1:5432/agent
